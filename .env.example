# Copy this file to `.env` and set your CORS origins.
# `.env` is gitignored and MUST never be committed.

# Comma-separated list of origins allowed to call the API (CORS).
# Add your Angular dev server and any deployed frontend.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# CognoDB instance password (the connection URI is in appsettings.json under
# ConnectionStrings:CognoDB). The password is shown exactly once at instance
# creation; store it here, never in source control.
COGNODB_PASSWORD=your-cognodb-instance-password
